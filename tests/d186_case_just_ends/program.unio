proc.main
    var bag: List<Text>[len.max: 1] = [];
    bag.add("Gem") otherwise
        case full
            show_msg("Your bag is full!");
    end otherwise
    bag.add("Key") otherwise
        case full
            show_msg("Your bag is full!");
    end otherwise
    show_msg("Onward!");
    show_msg(be.Text(bag.len));
end proc.main
