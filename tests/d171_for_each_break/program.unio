proc.main
    let scores: List<Whole> = [5, 12, 8, 30];
    var total: Whole = 0;
    for each score in scores
        if score eq 8
            break;
        else
            total = total + score;
            show_msg(be.Text(score));
        end if
    end for
    show_msg("Total: {total}");
end proc.main
