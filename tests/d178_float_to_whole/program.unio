proc show_ways[x: Float]:
    let down: Whole = be.Whole.floor(x);
    let cut: Whole = be.Whole.trunc(x);
    let up: Whole = be.Whole.ceil(x);
    let near: Whole = be.Whole.nearest(x);
    let even: Whole = be.Whole.nearest.even(x);
    show_msg.fmt("{down} {cut} {up} {near} {even}");
end proc show_ways

proc.main:
    show_ways(~2.7);
    show_ways(0.0 - ~2.7);
    show_ways(2.5);
    show_ways(0.0 - 2.5);
    show_ways(3.5);
end proc.main
