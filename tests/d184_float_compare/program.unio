proc.main
    let sum: Float = ~0.1 + ~0.2;
    if sum eq ~0.3
        show_msg("same");
    else
        show_msg("different");
    end if
    if sum > ~0.3
        show_msg("above");
    end if
    let total: Float = 0.5 + 0.25;
    if total eq 0.75
        show_msg("exact");
    end if
    let flipped: Float = 0.0 * -1.0;
    if flipped eq 0.0
        show_msg("zero");
    end if
    var timer: Float = 0.0;
    var steps: Whole = 0;
    while timer < 1.0
        timer = timer + ~0.1;
        steps = steps + 1;
    end while
    show_msg("{steps} steps, {timer}");
end proc.main
