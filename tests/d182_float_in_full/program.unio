proc.main
    let huge: Float = 10000000000000000000000.0;
    show_msg(be.Text(huge));
    var doubled: Float = 1.0;
    var times: Whole = 0;
    while times < 70
        doubled = doubled * 2.0;
        times = times + 1;
    end while
    show_msg(be.Text(doubled));
    let tiny: Float = ~0.00001;
    show_msg(be.Text(tiny));
end proc.main
