; The one command: dune build @check -j 3
; builds everything, checks every proof and its assumptions, and runs every test.

(rule
 (alias check)
 (deps (universe) shell/ralph.exe assumptions/assumptions.txt assumptions/axioms.txt)
 (action
  (run
   %{exe:tests/run_tests.exe}
   %{dep:shell/ralph.exe}
   %{dep:assumptions/assumptions.txt}
   %{dep:assumptions/axioms.txt})))

; Reading and showing `Float`s aren't proven yet, so they're tested against Python on thousands of numbers.

(rule
 (alias check)
 (deps tests/floats_check.py)
 (action
  (progn
   (with-stdout-to floats.txt (run %{exe:tests/floats.exe}))
   (run python3 -I %{dep:tests/floats_check.py} floats.txt))))
